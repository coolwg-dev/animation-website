---
import BaseLayout from '../layouts/BaseLayout.astro';

import video_scene01 from '/videos/monte_carlo/scene_01_intro/480p15/IntroductionToUncertainty.mp4';
import video_scene02 from '/videos/monte_carlo/scene_02_monte_carlo/480p15/MonteCarloIntroScene.mp4';
import video_scene03 from '/videos/monte_carlo/scene_03_pi_setup/480p15/PiEstimationSetup.mp4';
import video_scene04 from '/videos/monte_carlo/scene_04_random_points_begin/480p15/RandomPointsBegin.mp4';
import video_scene05 from '/videos/monte_carlo/scene_05_accumulation_of_points/480p15/AccumulationOfPoints.mp4';
import video_scene06 from '/videos/monte_carlo/scene_06_counting_and_ratios/480p15/CountingAndRatios.mp4';
import video_scene07 from '/videos/monte_carlo/scene_07_formula_emerges/480p15/FormulaEmerges.mp4';
import video_scene08 from '/videos/monte_carlo/scene_08_convergence/480p15/ConvergencePowerOfMany.mp4';

const title = "Monte Carlo Methods";

const scenesMap = {
  scene_01_intro: { title: 'Introduction to Uncertainty', video: video_scene01 },
  scene_02_monte_carlo: { title: 'Introducing Monte Carlo', video: video_scene02 },
  scene_03_pi_setup: { title: 'Estimating Pi Setup', video: video_scene03 },
  scene_04_random_points_begin: { title: 'Random Sampling Begins', video: video_scene04 },
  scene_05_accumulation_of_points: { title: 'Accumulation of Points', video: video_scene05 },
  scene_06_counting_and_ratios: { title: 'Counting and Ratios', video: video_scene06 },
  scene_07_formula_emerges: { title: 'Formula Emerges', video: video_scene07 },
  scene_08_convergence: { title: 'Convergence', video: video_scene08 },
};

const scenesWithVideos = Object.entries(scenesMap).map(([id, info]) => ({ id, title: info.title, video: info.video }));
---

<BaseLayout title={title}>
  <style>
    .video-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(360px, 1fr));
      gap: 2rem;
      margin-top: 3rem;
    }
    
    .video-card {
      padding: 1.75rem;
      border-radius: 20px;
      background: rgba(255, 255, 255, 0.95);
      backdrop-filter: blur(10px);
      border: 1px solid rgba(255, 255, 255, 0.5);
      box-shadow: 0 8px 32px rgba(0, 0, 0, 0.15);
      transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
      position: relative;
      overflow: hidden;
    }
    
    .video-card::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 4px;
      background: linear-gradient(90deg, #667eea 0%, #764ba2 100%);
      transform: scaleX(0);
      transform-origin: left;
      transition: transform 0.4s ease;
    }
    
    .video-card:hover {
      transform: translateY(-6px) scale(1.02);
      box-shadow: 0 16px 48px rgba(102, 126, 234, 0.25);
    }
    
    .video-card:hover::before {
      transform: scaleX(1);
    }
    
    .video-card h4 {
      margin: 0 0 1.25rem;
      color: #1e293b;
      font-size: 1.25rem;
      font-weight: 700;
      background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }
    
    .video-card iframe {
      width: 100%;
      height: 300px;
      border: 0;
      background: #000;
      border-radius: 12px;
      box-shadow: 0 4px 16px rgba(0, 0, 0, 0.2);
    }
    
    .no-video {
      background: rgba(248, 250, 252, 0.8);
      padding: 3rem 1rem;
      border-radius: 12px;
      color: #64748b;
      text-align: center;
      font-weight: 500;
    }
    
    @media (max-width: 768px) {
      .video-grid {
        grid-template-columns: 1fr;
        gap: 1.5rem;
      }
      
      .video-card {
        padding: 1.5rem;
      }
      
      .video-card iframe {
        height: 250px;
      }
    }
  </style>

  <h2>Monte Carlo Methods</h2>
  <p>Explore Monte Carlo simulation techniques through a series of animations demonstrating randomness, estimation, and statistical convergence.</p>

  <div class="video-grid">
    {scenesWithVideos.map(scene => (
      <article class="video-card">
        <h4>{scene.title}</h4>
        {scene.video ? (
          <iframe src={scene.video} title={scene.title} allowfullscreen />
        ) : (
          <div class="no-video">Video not available</div>
        )}
      </article>
    ))}
  </div>
</BaseLayout>
