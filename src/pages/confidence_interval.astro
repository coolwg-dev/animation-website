---
import BaseLayout from '../layouts/BaseLayout.astro';
const title = 'Confidence Intervals';

import CIConstruction from '../../public/videos/Confidence interval/ConfidenceIntervalConstruction.mp4';
import CLI_720 from '../../public/videos/Confidence interval/ConfidenceLevelInterpretation_720p30.mp4';
import DC_1080_60 from '../../public/videos/Confidence interval/DistributionComparison_1080p60.mp4';

const videos = [
  { src: CIConstruction, title: 'Confidence Interval Construction', description: 'Learn how confidence intervals are constructed' },
  { src: CLI_720, title: 'Confidence Level Interpretation', description: 'Understanding confidence levels' },
  { src: DC_1080_60, title: 'Distribution Comparison', description: 'Comparing different distributions' },
];
---

<BaseLayout title={title}>
  <style>
    .video-list {
      list-style: none;
      padding: 0;
      margin-top: 3rem;
    }
    
    .video-item {
      margin-bottom: 3rem;
      padding: 2rem;
      background: rgba(255, 255, 255, 0.95);
      backdrop-filter: blur(10px);
      border-radius: 20px;
      border: 1px solid rgba(255, 255, 255, 0.5);
      box-shadow: 0 8px 32px rgba(0, 0, 0, 0.15);
      transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    }
    
    .video-item:hover {
      transform: translateY(-4px);
      box-shadow: 0 12px 48px rgba(102, 126, 234, 0.25);
    }
    
    .video-item h4 {
      margin: 0 0 0.75rem;
      color: #1e293b;
      font-size: 1.5rem;
      font-weight: 700;
      background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }
    
    .video-item .description {
      color: #475569;
      margin-bottom: 1.5rem;
      font-size: 1rem;
      font-weight: 500;
      line-height: 1.6;
    }
    
    .video-item iframe {
      width: 100%;
      max-width: 1000px;
      height: 560px;
      border: 0;
      border-radius: 16px;
      background: #000;
      box-shadow: 0 8px 24px rgba(0, 0, 0, 0.2);
    }
    
    @media (max-width: 768px) {
      .video-item {
        padding: 1.5rem;
      }
      
      .video-item iframe {
        height: 300px;
        border-radius: 12px;
      }
      
      .video-item h4 {
        font-size: 1.25rem;
      }
    }
  </style>

  <h2>Confidence Intervals</h2>
  <p>Understand confidence intervals through visual demonstrations of construction, interpretation, and statistical distributions.</p>

  {videos.length && (
    <ul class="video-list">
      {videos.map(v => (
        <li class="video-item">
          <h4>{v.title}</h4>
          <div class="description">{v.description}</div>
          <iframe src={v.src} title={v.title} allowfullscreen></iframe>
        </li>
      ))}
    </ul>
  )}
</BaseLayout>
