---
const { title = 'Mathematical Animation Gallery' } = Astro.props;
const year = new Date().getFullYear();
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{title}</title>
    <link rel="icon" href="/favicon.svg" />
    <style>
      * {
        box-sizing: border-box;
      }
      
      body {
        font-family: system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
        margin: 0;
        padding: 0;
        color: #1e293b;
        background: linear-gradient(180deg, #ffffff 0%, #f1f5f9 100%);
        line-height: 1.6;
      }
      
      header {
        padding: 1.5rem 2rem;
        background: linear-gradient(135deg, #0891b2 0%, #06b6d4 100%);
        color: white;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
      }
      
      header h1 {
        margin: 0;
        font-size: 1.75rem;
        font-weight: 600;
        letter-spacing: -0.025em;
      }
      
      header .container {
        display: flex;
        align-items: center;
        justify-content: space-between;
        max-width: 1200px;
        margin: 0 auto;
        gap: 2rem;
      }
      
      nav {
        display: flex;
        gap: 0.25rem;
        flex-wrap: wrap;
      }
      
      nav a {
        padding: 0.5rem 1rem;
        color: white;
        text-decoration: none;
        border-radius: 6px;
        transition: all 0.2s ease;
        font-weight: 500;
        font-size: 0.95rem;
      }
      
      nav a:hover {
        background: rgba(255, 255, 255, 0.15);
        transform: translateY(-1px);
      }
      
      nav a:active {
        transform: translateY(0);
      }
      
      main {
        padding: 3rem 2rem;
        max-width: 1200px;
        margin: 0 auto;
        min-height: calc(100vh - 200px);
      }
      
      main h2 {
        color: #0f172a;
        font-size: 2rem;
        font-weight: 700;
        margin-top: 0;
        margin-bottom: 1rem;
      }
      
      main h3 {
        color: #334155;
        font-size: 1.5rem;
        font-weight: 600;
        margin-top: 2rem;
        margin-bottom: 1rem;
      }
      
      main p {
        color: #475569;
        line-height: 1.7;
        max-width: 800px;
      }
      
      a {
        color: #0891b2;
        text-decoration: none;
        transition: color 0.2s ease;
      }
      
      a:hover {
        color: #06b6d4;
      }
      
      code {
        background: #e2e8f0;
        padding: 0.25rem 0.5rem;
        border-radius: 4px;
        font-size: 0.9em;
        color: #334155;
        font-family: 'Courier New', Courier, monospace;
      }
      
      footer {
        padding: 2rem;
        text-align: center;
        font-size: 0.9rem;
        color: #64748b;
        background: white;
        border-top: 1px solid #e2e8f0;
        margin-top: 2rem;
      }
      
      @media (max-width: 768px) {
        header .container {
          flex-direction: column;
          align-items: flex-start;
          gap: 1rem;
        }
        
        header h1 {
          font-size: 1.5rem;
        }
        
        nav {
          width: 100%;
        }
        
        nav a {
          font-size: 0.9rem;
          padding: 0.4rem 0.8rem;
        }
        
        main {
          padding: 2rem 1rem;
        }
        
        main h2 {
          font-size: 1.75rem;
        }
      }
    </style>
  </head>
  <body>
    <header>
      <div class="container">
        <h1>Mathematical Animation Gallery</h1>
        <nav aria-label="Main navigation">
          <a href="/">Home</a>
          <a href="/fourier_square_wave">Fourier</a>
          <a href="/power_curves">Power Curves</a>
          <a href="/riemann_sum_manim">Riemann Sum</a>
          <a href="/secant_to_tangent">Secant to Tangent</a>
          <a href="/monte-carlo">Monte Carlo</a>
          <a href="/vector_transformation">Vectors</a>
        </nav>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer>
      © {year} Mathematical Animation Gallery. All rights reserved.
    </footer>
  </body>
</html>
