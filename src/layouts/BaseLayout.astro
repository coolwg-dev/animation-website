---
const { title = 'Mathematical Animation Gallery' } = Astro.props;
const year = new Date().getFullYear();
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{title}</title>
    <link rel="icon" href="/favicon.svg" />
    <style>
      * {
        box-sizing: border-box;
      }
      
      body {
        font-family: system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
        margin: 0;
        padding: 0;
        color: #1e293b;
        background: linear-gradient(180deg, #ffffff 0%, #f1f5f9 100%);
        line-height: 1.6;
      }
      
      header {
        padding: 1.5rem 2rem;
        background: linear-gradient(135deg, #0891b2 0%, #06b6d4 100%);
        color: white;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
      }
      
      header h1 {
        margin: 0;
        font-size: 1.75rem;
        font-weight: 600;
        letter-spacing: -0.025em;
      }
      
      header .container {
        display: flex;
        align-items: center;
        justify-content: space-between;
        max-width: 1200px;
        margin: 0 auto;
        gap: 2rem;
      }
      
      nav {
        display: flex;
        gap: 0.25rem;
        flex-wrap: wrap;
        align-items: center;
      }
      
      nav a {
        padding: 0.5rem 1rem;
        color: white;
        text-decoration: none;
        border-radius: 6px;
        transition: all 0.2s ease;
        font-weight: 500;
        font-size: 0.95rem;
      }
      
      nav a:hover {
        background: rgba(255, 255, 255, 0.15);
        transform: translateY(-1px);
      }
      
      nav a:active {
        transform: translateY(0);
      }
      
      /* Dropdown menu styles */
      .nav-dropdown {
        position: relative;
      }
      
      .nav-dropdown > button {
        padding: 0.5rem 1rem;
        color: white;
        background: transparent;
        border: none;
        border-radius: 6px;
        transition: all 0.2s ease;
        font-weight: 500;
        font-size: 0.95rem;
        cursor: pointer;
        font-family: inherit;
        display: flex;
        align-items: center;
        gap: 0.25rem;
      }
      
      .nav-dropdown > button::after {
        content: '▾';
        font-size: 0.8rem;
        transition: transform 0.2s ease;
      }
      
      .nav-dropdown > button:hover {
        background: rgba(255, 255, 255, 0.15);
      }
      
      .nav-dropdown:hover > button::after,
      .nav-dropdown.active > button::after {
        transform: rotate(180deg);
      }
      
      .dropdown-content {
        position: absolute;
        top: 100%;
        left: 0;
        margin-top: 0.5rem;
        background: white;
        border-radius: 8px;
        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.15);
        min-width: 200px;
        opacity: 0;
        visibility: hidden;
        transform: translateY(-10px);
        transition: all 0.2s ease;
        z-index: 1000;
      }
      
      .nav-dropdown:hover .dropdown-content,
      .nav-dropdown.active .dropdown-content {
        opacity: 1;
        visibility: visible;
        transform: translateY(0);
      }
      
      .dropdown-content a {
        display: block;
        padding: 0.75rem 1rem;
        color: #334155;
        text-decoration: none;
        transition: all 0.15s ease;
        font-size: 0.9rem;
        border-radius: 0;
      }
      
      .dropdown-content a:first-child {
        border-radius: 8px 8px 0 0;
      }
      
      .dropdown-content a:last-child {
        border-radius: 0 0 8px 8px;
      }
      
      .dropdown-content a:hover {
        background: #f1f5f9;
        color: #0891b2;
        transform: translateX(4px);
      }
      
      main {
        padding: 3rem 2rem;
        max-width: 1200px;
        margin: 0 auto;
        min-height: calc(100vh - 200px);
      }
      
      main h2 {
        color: #0f172a;
        font-size: 2rem;
        font-weight: 700;
        margin-top: 0;
        margin-bottom: 1rem;
      }
      
      main h3 {
        color: #334155;
        font-size: 1.5rem;
        font-weight: 600;
        margin-top: 2rem;
        margin-bottom: 1rem;
      }
      
      main p {
        color: #475569;
        line-height: 1.7;
        max-width: 800px;
      }
      
      a {
        color: #0891b2;
        text-decoration: none;
        transition: color 0.2s ease;
      }
      
      a:hover {
        color: #06b6d4;
      }
      
      code {
        background: #e2e8f0;
        padding: 0.25rem 0.5rem;
        border-radius: 4px;
        font-size: 0.9em;
        color: #334155;
        font-family: 'Courier New', Courier, monospace;
      }
      
      footer {
        padding: 2rem;
        text-align: center;
        font-size: 0.9rem;
        color: #64748b;
        background: white;
        border-top: 1px solid #e2e8f0;
        margin-top: 2rem;
      }
      
      @media (max-width: 768px) {
        header .container {
          flex-direction: column;
          align-items: flex-start;
          gap: 1rem;
        }
        
        header h1 {
          font-size: 1.5rem;
        }
        
        nav {
          width: 100%;
          flex-direction: column;
          gap: 0.5rem;
        }
        
        nav > a {
          font-size: 0.9rem;
          padding: 0.4rem 0.8rem;
          width: 100%;
        }
        
        .nav-dropdown {
          width: 100%;
        }
        
        .nav-dropdown > button {
          width: 100%;
          justify-content: space-between;
          font-size: 0.9rem;
          padding: 0.4rem 0.8rem;
        }
        
        .dropdown-content {
          position: static;
          margin-top: 0;
          margin-left: 1rem;
          box-shadow: none;
          background: rgba(255, 255, 255, 0.1);
          border-radius: 6px;
          max-height: 0;
          overflow: hidden;
          opacity: 1;
          visibility: visible;
          transform: none;
        }
        
        .nav-dropdown.active .dropdown-content {
          max-height: 500px;
          margin-top: 0.5rem;
        }
        
        .dropdown-content a {
          color: white;
          padding: 0.5rem 0.8rem;
          font-size: 0.85rem;
        }
        
        .dropdown-content a:hover {
          background: rgba(255, 255, 255, 0.15);
          transform: translateX(0);
        }
        
        main {
          padding: 2rem 1rem;
        }
        
        main h2 {
          font-size: 1.75rem;
        }
      }
    </style>
  </head>
  <body>
    <header>
      <div class="container">
        <h1>Mathematical Animation Gallery</h1>
        <nav aria-label="Main navigation">
          <a href="/">Home</a>
          
          <div class="nav-dropdown">
            <button type="button" aria-haspopup="true" aria-expanded="false">Calculus</button>
            <div class="dropdown-content" role="menu">
              <a href="/riemann_sum_manim" role="menuitem">Riemann Sums</a>
              <a href="/fourier_square_wave" role="menuitem">Fourier Series</a>
              <a href="/secant_to_tangent" role="menuitem">Secant to Tangent</a>
            </div>
          </div>
          
          <div class="nav-dropdown">
            <button type="button" aria-haspopup="true" aria-expanded="false">Statistics</button>
            <div class="dropdown-content" role="menu">
              <a href="/monte-carlo" role="menuitem">Monte Carlo</a>
              <a href="/confidence_interval" role="menuitem">Confidence Intervals</a>
              <a href="/power_curves" role="menuitem">Power Curves</a>
            </div>
          </div>
          
          <div class="nav-dropdown">
            <button type="button" aria-haspopup="true" aria-expanded="false">Geometry</button>
            <div class="dropdown-content" role="menu">
              <a href="/centers" role="menuitem">Triangle Centers</a>
            </div>
          </div>
          
          <div class="nav-dropdown">
            <button type="button" aria-haspopup="true" aria-expanded="false">Linear Algebra</button>
            <div class="dropdown-content" role="menu">
              <a href="/vector_transformation" role="menuitem">Vector Transformations</a>
            </div>
          </div>
        </nav>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer>
      © {year} Mathematical Animation Gallery. All rights reserved.
    </footer>
    
    <script>
      // Handle dropdown toggle on mobile and for accessibility
      document.addEventListener('DOMContentLoaded', () => {
        const dropdowns = document.querySelectorAll('.nav-dropdown');
        
        dropdowns.forEach(dropdown => {
          const button = dropdown.querySelector('button');
          
          button?.addEventListener('click', (e) => {
            e.stopPropagation();
            
            // Close other dropdowns
            dropdowns.forEach(other => {
              if (other !== dropdown) {
                other.classList.remove('active');
                const otherButton = other.querySelector('button');
                if (otherButton) {
                  otherButton.setAttribute('aria-expanded', 'false');
                }
              }
            });
            
            // Toggle current dropdown
            const isActive = dropdown.classList.toggle('active');
            button.setAttribute('aria-expanded', isActive ? 'true' : 'false');
          });
        });
        
        // Close dropdowns when clicking outside
        document.addEventListener('click', () => {
          dropdowns.forEach(dropdown => {
            dropdown.classList.remove('active');
            const button = dropdown.querySelector('button');
            if (button) {
              button.setAttribute('aria-expanded', 'false');
            }
          });
        });
        
        // Keyboard navigation
        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape') {
            dropdowns.forEach(dropdown => {
              dropdown.classList.remove('active');
              const button = dropdown.querySelector('button');
              if (button) {
                button.setAttribute('aria-expanded', 'false');
              }
            });
          }
        });
      });
    </script>
  </body>
</html>
